      },
      "thresholds": {
        "manager_approval_review": 78,
        "lnd_review": 52
      }
    },
    "Data Analyst": {
      "criteria": {
        "role_relevance_score": 30,
        "skill_gap_alignment_score": 45,
        "prerequisite_completion_score": 25
      },
      "thresholds": {
        "manager_approval_review": 76,
        "lnd_review": 52
      }
    }
  },
  "review_actions": [
    "APPROVE",
    "EDIT",
    "HOLD",
    "REQUEST_INFO"
  ],
  "sla_hours": 48,
  "notification_max_retries": 2
}
